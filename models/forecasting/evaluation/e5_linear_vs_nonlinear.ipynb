    "def qlike(rv, f, normalised=True):\n",
    "    r = rv / f\n",
    "    return r - np.log(r) - 1.0 if normalised else r + np.log(f)\n",
    "\n",
    "panel[\"se_en\"]  = (panel.actual_logRV - panel.fc_log_en) ** 2\n",
    "panel[\"se_xgb\"] = (panel.actual_logRV - panel.fc_log_xgb) ** 2\n",
    "panel[\"ql_en\"]  = qlike(panel.actual_RV, panel.fc_level_en,  QLIKE_NORMALISED)\n",
    "panel[\"ql_xgb\"] = qlike(panel.actual_RV, panel.fc_level_xgb, QLIKE_NORMALISED)\n",
    "\n",
    "# Loss differential d_t = L_EN - L_XGB.   d_t > 0  <=>  XGB had the LOWER loss in that month.\n",
    "panel[\"d_mse\"]   = panel.se_en - panel.se_xgb\n",
    "panel[\"d_qlike\"] = panel.ql_en - panel.ql_xgb\n",
    "\n",
    "panel[[\"info_set\", \"etf\", \"date\", \"se_en\", \"se_xgb\", \"ql_en\", \"ql_xgb\", \"d_mse\", \"d_qlike\"]].head()"
   ]
