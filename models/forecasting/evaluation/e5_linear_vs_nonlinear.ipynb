   "source": [
    "def dm_test(d, h=1, hln=True):\n",
    "    # Diebold-Mariano test on a loss-differential series d_t = L_A,t - L_B,t.\n",
    "    # Returns mean(d), DM statistic, two-sided p, and one-sided p for H1: mean(d) > 0 (B better than A).\n",
    "    d = np.asarray(d, dtype=float)\n",
    "    d = d[~np.isnan(d)]\n",
    "    T = len(d)\n",
    "    dbar = d.mean()\n",
    "    dc = d - dbar\n",
    "    var = (dc @ dc) / T                                  # gamma_0\n",
    "    for k in range(1, h):                                # + 2 * sum_{k=1}^{h-1} gamma_k\n",
    "        var += 2.0 * (dc[k:] @ dc[:-k]) / T\n",
    "    if var <= 0:\n",
    "        return dict(T=T, mean_d=dbar, dm_stat=np.nan, p_two_sided=np.nan, p_xgb_better=np.nan)\n",
    "    stat = dbar / np.sqrt(var / T)\n",
    "    if hln:\n",
    "        stat *= np.sqrt((T + 1 - 2 * h + h * (h - 1) / T) / T)\n",
    "        p2, p1 = 2 * stats.t.sf(abs(stat), T - 1), stats.t.sf(stat, T - 1)\n",
    "    else:\n",
    "        p2, p1 = 2 * stats.norm.sf(abs(stat)), stats.norm.sf(stat)\n",
    "    return dict(T=T, mean_d=dbar, dm_stat=stat, p_two_sided=p2, p_xgb_better=p1)\n",
    "\n",
    "# --- sanity check on simulated data: DM should reject rarely when the null is true, often when it is false ---\n",
    "rng = np.random.default_rng(0)\n",
    "null_rej = np.mean([dm_test(rng.normal(0.0, 1, 214), H, HLN_CORRECTION)[\"p_two_sided\"] < ALPHA for _ in range(2000)])\n",
    "alt_rej  = np.mean([dm_test(rng.normal(0.3, 1, 214), H, HLN_CORRECTION)[\"p_two_sided\"] < ALPHA for _ in range(2000)])\n",
    "print(f\"Simulation check (T=214): rejection rate under H0 = {null_rej:.3f} (target {ALPHA}), under a true mean of 0.3 = {alt_rej:.3f}\")"
   ]
  },
