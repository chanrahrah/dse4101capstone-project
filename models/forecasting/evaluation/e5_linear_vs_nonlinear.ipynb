    "def in_window(df, start, end):\n",
    "    out = df\n",
    "    if start is not None: out = out[out.date >= pd.Timestamp(start)]\n",
    "    if end   is not None: out = out[out.date <= pd.Timestamp(end)]\n",
    "    return out\n",
    "\n",
    "label_of = INFO_SETS\n",
    "loss_rows = []\n",
    "for sname, (s, e) in SUBSAMPLES.items():\n",
    "    sub = in_window(panel, s, e)\n",
    "    for key, g in sub.groupby(\"info_set\"):\n",
    "        for etf, gg in list(g.groupby(\"etf\")) + ([(\"ALL (avg)\", g)] if POOL_ETFS else []):\n",
    "            for model, se, ql in [(\"EN\", gg.se_en, gg.ql_en), (\"XGB\", gg.se_xgb, gg.ql_xgb)]:\n",
    "                loss_rows.append(dict(subsample=sname, info_set=key, etf=etf, model=model,\n",
    "                                      n=len(gg), mse_logrv=se.mean(), qlike=ql.mean()))\n",
    "losses = pd.DataFrame(loss_rows)\n",
    "\n",
    "ratio = (losses.pivot_table(index=[\"subsample\", \"info_set\", \"etf\"], columns=\"model\", values=[\"mse_logrv\", \"qlike\"])\n",
    "               .pipe(lambda x: pd.DataFrame({\n",
    "                   \"n\": losses.groupby([\"subsample\", \"info_set\", \"etf\"]).n.first(),\n",
    "                   \"MSE_EN\": x[(\"mse_logrv\", \"EN\")], \"MSE_XGB\": x[(\"mse_logrv\", \"XGB\")],\n",
    "                   \"MSE ratio XGB/EN\": x[(\"mse_logrv\", \"XGB\")] / x[(\"mse_logrv\", \"EN\")],\n",
    "                   \"QLIKE_EN\": x[(\"qlike\", \"EN\")], \"QLIKE_XGB\": x[(\"qlike\", \"XGB\")],\n",
    "                   \"QLIKE ratio XGB/EN\": x[(\"qlike\", \"XGB\")] / x[(\"qlike\", \"EN\")]})))\n",
    "ratio_display = ratio.reset_index()\n",
    "ratio_display[\"info_set\"] = ratio_display.info_set.map(label_of)\n",
    "ratio_display"
   ]
