   "source": [
    "def pooled_series(g, col):\n",
    "    # cross-ETF mean of the loss differential for each date (only dates where all ETFs are present)\n",
    "    wide = g.pivot(index=\"date\", columns=\"etf\", values=col)\n",
    "    return wide.dropna().mean(axis=1)\n",
    "\n",
    "dm_rows = []\n",
    "for sname, (s, e) in SUBSAMPLES.items():\n",
    "    sub = in_window(panel, s, e)\n",
    "    for key in INFO_SETS:\n",
    "        g = sub[sub.info_set == key]\n",
    "        targets = [(etf, gg.sort_values(\"date\")) for etf, gg in g.groupby(\"etf\")]\n",
    "        for etf, gg in targets:\n",
    "            for loss_name, dcol, a, b in [(\"MSE (log RV)\", \"d_mse\", \"se_en\", \"se_xgb\"),\n",
    "                                          (\"QLIKE (RV level)\", \"d_qlike\", \"ql_en\", \"ql_xgb\")]:\n",
    "                res = dm_test(gg[dcol], H, HLN_CORRECTION)\n",
    "                dm_rows.append(dict(subsample=sname, info_set=key, etf=etf, loss=loss_name,\n",
    "                                    loss_EN=gg[a].mean(), loss_XGB=gg[b].mean(), **res))\n",
    "        if POOL_ETFS:\n",
    "            for loss_name, dcol, a, b in [(\"MSE (log RV)\", \"d_mse\", \"se_en\", \"se_xgb\"),\n",
    "                                          (\"QLIKE (RV level)\", \"d_qlike\", \"ql_en\", \"ql_xgb\")]:\n",
    "                d_pool = pooled_series(g, dcol)\n",
    "                res = dm_test(d_pool, H, HLN_CORRECTION)\n",
    "                dm_rows.append(dict(subsample=sname, info_set=key, etf=\"ALL (avg)\", loss=loss_name,\n",
    "                                    loss_EN=g[a].mean(), loss_XGB=g[b].mean(), **res))\n",
    "\n",
    "dm = pd.DataFrame(dm_rows)\n",
    "dm[\"ratio_XGB_over_EN\"] = dm.loss_XGB / dm.loss_EN\n",
    "dm[\"sig_two_sided_5pct\"] = dm.p_two_sided < ALPHA\n",
    "dm[\"winner\"] = np.where(dm.p_two_sided < ALPHA, np.where(dm.mean_d > 0, \"XGB\", \"EN\"), \"no sig. difference\")\n",
    "dm[\"cell\"] = dm.info_set.map(INFO_SETS)\n",
    "\n",
    "show = dm[[\"subsample\", \"cell\", \"etf\", \"loss\", \"T\", \"loss_EN\", \"loss_XGB\", \"ratio_XGB_over_EN\",\n",
    "           \"dm_stat\", \"p_two_sided\", \"p_xgb_better\", \"winner\"]]\n",
    "display(show)"
   ]
  },
