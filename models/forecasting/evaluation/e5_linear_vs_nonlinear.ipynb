    "def andrews_bandwidth(x):\n",
    "    x = np.asarray(x, float); n = len(x); xd = x - x.mean()\n",
    "    den = float(xd[:-1] @ xd[:-1])\n",
    "    rho = 0.0 if den <= 0 else float(xd[1:] @ xd[:-1]) / den\n",
    "    rho = min(max(rho, -0.97), 0.97)\n",
    "    a1 = 4.0 * rho ** 2 / ((1 - rho) ** 2 * (1 + rho) ** 2)\n",
    "    return 0 if a1 <= 0 else int(min(np.floor(1.1447 * (a1 * n) ** (1 / 3)), n // 4))\n",
    "\n",
    "def newey_west_lrv(x, lag):\n",
    "    x = np.asarray(x, float); n = len(x); xd = x - x.mean()\n",
    "    lag = max(0, min(lag, n - 1)); s = float(xd @ xd) / n\n",
    "    for l in range(1, lag + 1):\n",
    "        s += 2.0 * (1.0 - l / (lag + 1.0)) * float(xd[l:] @ xd[:-l]) / n\n",
    "    return max(s, 1e-16)\n",
    "\n",
    "def hac_t(d):\n",
    "    '''t-statistic of mean(d) with a Newey-West variance.'''\n",
    "    d = np.asarray(d, float)\n",
    "    return d.mean() / np.sqrt(newey_west_lrv(d, andrews_bandwidth(d)) / len(d))\n",
    "\n",
    "def qlike(rv, fc):\n",
    "    r = rv / fc\n",
    "    return r - np.log(r) - 1"
   ],
