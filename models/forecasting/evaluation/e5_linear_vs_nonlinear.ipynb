    "loss_idx = losses.set_index([\"model\", \"ETF\"])\n",
    "rows = []\n",
    "for pair_id, a, b, _ in pairs:\n",
    "    A = d[d[\"model\"] == a].set_index([\"date\", \"etf\"])\n",
    "    B = d[d[\"model\"] == b].set_index([\"date\", \"etf\"])\n",
    "    diffs = {\"QLIKE\": A[\"QLIKE\"] - B[\"QLIKE\"],        # negative favours a\n",
    "             \"MSE_log\": A[\"MSE_log\"] - B[\"MSE_log\"]}  # negative favours a\n",
    "    for etf in [\"pooled\"] + TICKERS:\n",
    "        for loss, diff in diffs.items():\n",
    "            series = diff.groupby(\"date\").mean() if etf == \"pooled\" else diff.xs(etf, level=\"etf\")\n",
    "            t = -hac_t(series)\n",
